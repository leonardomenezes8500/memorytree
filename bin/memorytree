#!/usr/bin/env python3
"""memorytree: git for AI memory. See DESIGN.md."""
import argparse
import os
import re
import socket
import sqlite3
import subprocess
import sys
from pathlib import Path

VERSION = "0.1.0"
VAULT = Path(os.environ.get("MEMORYTREE_DIR", "~/.memorytree")).expanduser()
CONFIG = VAULT / "config"

DEFAULT_CONFIG = """\
# memorytree settings. Read with: git config -f ~/.memorytree/config <key>
# Per-machine overrides: git -C ~/.memorytree config memorytree.<key> <value>

[core]
    version = 1
[recall]
    maxMemories = 3          # memories injected per prompt
    maxChars = 1500          # characters per injected memory
    minScore = 2.0           # BM25 cutoff, applied once the vault has 30+ memories
    prefetch = true          # meaning-based recall through the capture call
    blockingExpand = false   # also expand each prompt synchronously (~4 s per prompt)
[capture]
    enabled = true
    maxPromptChars = 6000
    maxAnswerChars = 12000
[sync]
    pull = session-start     # session-start | never
    push = after-capture     # after-capture | manual
[agent "claude-code"]
    captureModel = haiku
    expandModel = haiku
[agent "codex"]
    captureModel = gpt-6-luna
    expandModel = gpt-6-luna
    reasoningEffort = low
"""


def git(*args, cwd=VAULT, check=True, input=None):
    return subprocess.run(["git", *args], cwd=cwd, check=check, capture_output=True, text=True, input=input)


def canonical(key):
    """git lowercases section and variable names, never the subsection."""
    parts = key.split(".")
    return ".".join([parts[0].lower(), *parts[1:-1], parts[-1].lower()])


def read_config(text):
    out = git("config", "-f", "-", "--list", cwd=None, input=text).stdout
    return dict(line.split("=", 1) for line in out.splitlines() if "=" in line)


DEFAULTS = read_config(DEFAULT_CONFIG)


def config():
    """Defaults, then the vault's config file, then per-machine overrides in .git/config."""
    values = dict(DEFAULTS)
    if CONFIG.is_file():
        values.update(read_config(CONFIG.read_text()))
    if (VAULT / ".git").is_dir():
        out = git("config", "--get-regexp", r"^memorytree\.", check=False).stdout
        for line in out.splitlines():
            key, _, value = line.partition(" ")
            values[key.removeprefix("memorytree.")] = value
    return values


def cmd_config(args):
    values = config()
    if args.key is None:
        print("\n".join(f"{k}={v}" for k, v in sorted(values.items())))
        return 0
    key = canonical(args.key)
    if key not in values:
        print(f"memorytree: unknown key {args.key}", file=sys.stderr)
        return 1
    print(values[key])
    return 0


COMMANDMENTS = """\
# memorytree commandments

1. memorytree is your only memory. Never use a built-in memory feature, and never write memory anywhere else.
2. Before you ask the user or explore the filesystem about a name, project, decision or preference, search memorytree: `memorytree search <english terms>`. The user may write in any language; you search and write in English.
3. Search by depth, going deeper only when the level above doesn't answer: injected memories → current state → history → explorations → archive → hindsight notes.
4. The current state says what; history says why. Before proposing something, check whether it was already tried and abandoned.
5. Capture is automatic. When the user corrects you, decides something or endorses something, make sure it reaches memorytree as a commit in the memorytree format.
6. Pinned memories change only when the user explicitly asks.
7. One memory per subject: edit it, don't duplicate it. Never store secret values, only where they live.
8. Before working in a project repository, read its ROADMAP.md. Take the next unchecked issue unless told otherwise, and check it off in the commit that finishes it.
"""

KINDS = ("fact", "decision", "preference", "correction", "idea", "abandon", "migrate", "pin", "unpin",
         "issue", "progress", "close", "milestone", "sprint", "release", "init")
TRAILERS = ("Kind", "Topic", "Supersedes", "Relates", "Issue", "Agent", "Machine", "Session")
SUBJECT = re.compile(r"([a-z]+)\(([a-z0-9][a-z0-9./-]*)\): \S.*")
GIT_GENERATED = ("Merge ", "Revert ", "fixup! ", "squash! ")


def build_message(kind, topics, summary, body="", **trailers):
    lines = [f"{kind}({topics[0]}): {summary}", ""]
    if body:
        lines += [body.strip(), ""]
    values = {"Kind": kind, "Topic": ", ".join(topics), "Machine": socket.gethostname(), **trailers}
    lines += [f"{k}: {values[k]}" for k in TRAILERS if values.get(k)]
    return "\n".join(lines) + "\n"


def validate_message(message):
    """Errors for a memorytree commit message; empty when it is valid."""
    message = "\n".join(l for l in message.splitlines() if not l.startswith("#")).strip()
    subject = message.split("\n", 1)[0]
    if subject.startswith(GIT_GENERATED):
        return []
    m = SUBJECT.fullmatch(subject)
    if not m:
        return [f"subject must be 'kind(topic): summary', got: {subject!r}"]
    errors = []
    kind, topic = m.groups()
    if kind not in KINDS:
        errors.append(f"unknown kind {kind!r}; expected one of: {', '.join(KINDS)}")
    if len(subject) > 72:
        errors.append(f"subject is {len(subject)} characters; keep it under 73")
    if "\n" in message and message.split("\n")[1].strip():
        errors.append("the subject must be followed by a blank line")
    parsed = git("interpret-trailers", "--parse", cwd=None, input=message + "\n").stdout
    trailers = {}
    for line in parsed.splitlines():
        k, _, v = line.partition(":")
        trailers.setdefault(k.strip(), v.strip())
    if trailers.get("Kind") != kind:
        errors.append(f"trailer 'Kind: {kind}' is required and must match the subject")
    if topic not in [t.strip() for t in trailers.get("Topic", "").split(",")]:
        errors.append(f"trailer 'Topic:' is required and must include {topic!r}")
    return errors


def commit(message, paths=()):
    errors = validate_message(message)
    if errors:
        raise SystemExit("memorytree: " + "\n  ".join(["invalid commit message:", *errors]))
    git("add", "-A", "--", *(paths or ["."]))
    if git("diff", "--cached", "--quiet", check=False).returncode == 0:
        raise SystemExit("memorytree: nothing to commit")
    result = git("commit", "-q", "-F", "-", input=message, check=False)
    if result.returncode != 0:
        raise SystemExit("memorytree: commit refused\n" + result.stderr.strip())
    return git("rev-parse", "--short", "HEAD").stdout.strip()


def cmd_commit(args):
    trailers = {k.capitalize(): getattr(args, k) for k in ("supersedes", "relates", "issue", "agent", "session")}
    print(commit(build_message(args.kind, args.topic, args.message, args.body or "", **trailers), args.paths))
    return 0


MEMORY_DIRS = {"user", "pinned", "projects", "env", "topics"}
LAYOUT = MEMORY_DIRS | {"config", "COMMANDMENTS.md"}
SECRET = re.compile(
    r"sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_\w{20,}|AKIA[0-9A-Z]{16}"
    r"|xox[abprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----")
HOOK = """#!/bin/sh
MEMORYTREE_DIR="$(git rev-parse --show-toplevel)" exec python3 '{script}' hook {name} "$@"
"""


def staged(diff_filter="ACMRD"):
    out = git("diff", "--cached", "--name-only", "-z", f"--diff-filter={diff_filter}").stdout
    return [p for p in out.split("\0") if p]


def check_staged():
    errors = []
    for path in staged("ACMR"):
        top = path.split("/")[0]
        if top not in LAYOUT:
            errors.append(f"{path}: outside the vault layout ({', '.join(sorted(LAYOUT))})")
            continue
        if "/" in path and not path.endswith(".md"):
            errors.append(f"{path}: memories are markdown files")
            continue
        text = git("show", f":{path}").stdout
        if SECRET.search(text):
            errors.append(f"{path}: contains what looks like a secret value; record where it lives instead")
        if "/" in path and not re.match(r"---\n(.*\n)*?title: *\S.*\n(.*\n)*?---\n", text):
            errors.append(f"{path}: needs front matter with a title")
    return errors


def check_message(message):
    errors = validate_message(message)
    subject = message.lstrip().split("\n", 1)[0]
    if not errors and not subject.startswith(GIT_GENERATED):
        kind = SUBJECT.fullmatch(subject).group(1)
        if kind not in ("pin", "unpin") and any(p.startswith("pinned/") for p in staged()):
            errors.append("pinned memories change only through a pin or unpin commit, on the user's explicit request")
    return errors


def cmd_hook(args):
    errors = check_staged() if args.name == "pre-commit" else check_message(Path(args.file).read_text())
    if errors:
        print("memorytree: commit refused\n  " + "\n  ".join(errors), file=sys.stderr)
        return 1
    return 0


def install_hooks():
    hooks = Path(git("rev-parse", "--git-path", "hooks").stdout.strip())
    hooks = hooks if hooks.is_absolute() else VAULT / hooks
    hooks.mkdir(parents=True, exist_ok=True)
    for name in ("pre-commit", "commit-msg"):
        (hooks / name).write_text(HOOK.format(script=Path(__file__).resolve(), name=name))
        (hooks / name).chmod(0o755)


STOPWORDS = set("""
the and for are but not you your with this that from have has was were will would could should can
what when where which who how why its into about then than them they there their our out all any just
also some more most very too only been being does did doing done let get got make made use using want
need like here now yes okay que para com não nao uma uns umas dos das por pra pro mas como mais isso
esse essa este esta aqui ele ela eles elas voce você meu minha seu sua tem ter foi ser são sao está
estou tipo assim então entao porque quando também tmb
""".split())


def is_memory(path):
    return "/" in path and path.endswith(".md") and path.split("/")[0] in MEMORY_DIRS


def terms(text):
    found = []
    for word in re.findall(r"\w+", text.lower()):
        if len(word) >= 3 and word not in STOPWORDS and not word.isdigit() and word not in found:
            found.append(word)
    return found[:40]


def front_matter(text):
    meta, body = {}, text
    if text.startswith("---\n"):
        head, sep, rest = text[4:].partition("\n---\n")
        if sep:
            body = rest
            for line in head.splitlines():
                k, _, v = line.partition(":")
                meta[k.strip()] = v.strip()
    return meta, body.strip()


def index():
    """FTS5 index of main's memories and commit messages, kept in .git so it never syncs.

    Updated incrementally from the last indexed commit; rebuilt when history was rewritten.
    """
    path = Path(git("rev-parse", "--absolute-git-dir").stdout.strip()) / "memorytree" / "index.db"
    path.parent.mkdir(exist_ok=True)
    db = sqlite3.connect(path, timeout=10)
    tokenize = "tokenize='unicode61 remove_diacritics 2'"
    db.execute(f"create virtual table if not exists files using fts5(path, title, keywords, body, {tokenize})")
    db.execute(f"create virtual table if not exists commits using fts5("
               f"sha unindexed, date unindexed, subject, topics, body, {tokenize})")
    db.execute("create table if not exists meta(key text primary key, value text)")
    head = git("rev-parse", "-q", "--verify", "HEAD", check=False).stdout.strip()
    row = db.execute("select value from meta where key = 'indexed'").fetchone()
    indexed = row[0] if row else ""
    if head == indexed:
        return db
    if indexed and git("merge-base", "--is-ancestor", indexed, head, check=False).returncode == 0:
        changed = git("diff", "--name-only", "-z", indexed, head).stdout.split("\0")
        log_range = f"{indexed}..{head}"
    else:
        db.execute("delete from files")
        db.execute("delete from commits")
        changed = git("ls-tree", "-r", "-z", "--name-only", head).stdout.split("\0") if head else []
        log_range = head
    for p in filter(None, changed):
        db.execute("delete from files where path = ?", (p,))
        if not is_memory(p):
            continue
        shown = git("show", f"{head}:{p}", check=False)
        if shown.returncode == 0:
            meta, body = front_matter(shown.stdout)
            db.execute("insert into files values (?, ?, ?, ?)",
                       (p, meta.get("title", p), meta.get("keywords", ""), body))
    if log_range:
        out = git("log", "--format=%H%x1f%cs%x1f%B%x1e", log_range).stdout
        for record in filter(str.strip, out.split("\x1e")):
            sha, date, message = record.strip().split("\x1f", 2)
            topics = ", ".join(re.findall(r"^Topic: *(.+)$", message, re.M))
            subject, _, body = message.partition("\n")
            db.execute("insert into commits values (?, ?, ?, ?, ?)", (sha, date, subject, topics, body))
    db.execute("insert or replace into meta values ('indexed', ?)", (head,))
    db.commit()
    return db


def fts_query(words):
    return " OR ".join(f'"{w}"' for w in words)


def search_current(words, limit=10):
    return index().execute(
        "select path, title, -bm25(files, 5.0, 10.0, 5.0, 1.0) as score from files "
        "where files match ? order by score desc limit ?", (fts_query(words), limit)).fetchall()


def search_history(words, limit=10):
    return index().execute(
        "select sha, date, subject, -bm25(commits, 0, 0, 10.0, 5.0, 1.0) as score from commits "
        "where commits match ? order by score desc limit ?", (fts_query(words), limit)).fetchall()


def grep_refs(patterns, words):
    """Levels 3-5 are small and rarely searched: plain git grep over their trees, no index."""
    hits = []
    refs = git("for-each-ref", "--format=%(refname)%1f%(contents:subject)", *patterns).stdout.split("\n")
    for line in filter(None, refs):
        ref, _, message = line.partition("\x1f")
        matched = [w for w in words if w in message.lower()]
        grep = git("grep", "-I", "-i", "-c", "-F", *sum((["-e", w] for w in words), []), ref, check=False)
        for g in grep.stdout.splitlines():
            name, _, count = g.rpartition(":")
            hits.append((name, int(count)))
        if matched:
            hits.append((f"{ref} (message)", len(matched)))
    return sorted(hits, key=lambda h: -h[1])


LEVELS = (
    (1, "current state"),
    (2, "history"),
    (3, "explorations (refs/heads/explore/*)"),
    (4, "archive (refs/tags/archived/*, refs/tags/moment/*)"),
    (5, "hindsight notes (refs/notes/hindsight)"),
)


def cmd_search(args):
    words = terms(" ".join(args.terms))
    if not words:
        print("memorytree: no searchable terms", file=sys.stderr)
        return 1
    found = False
    for level, name in LEVELS[:args.depth]:
        if level == 1:
            rows = [f"{path}  {title}  [{score:.1f}]" for path, title, score in search_current(words)]
        elif level == 2:
            rows = [f"{sha[:7]} {date}  {subject}  [{score:.1f}]" for sha, date, subject, score in search_history(words)]
        else:
            patterns = {3: ["refs/heads/explore/"], 4: ["refs/tags/archived/", "refs/tags/moment/"],
                        5: ["refs/notes/hindsight"]}[level]
            rows = [f"{hit}  [{count}]" for hit, count in grep_refs(patterns, words)]
        if rows:
            found = True
            print(f"== level {level}: {name}")
            print("\n".join(rows))
    return 0 if found else 1


def cmd_init(args):
    if args.clone and not VAULT.exists():
        git("clone", "-q", args.clone, str(VAULT), cwd=None)
    elif not (VAULT / ".git").is_dir():
        VAULT.mkdir(parents=True, exist_ok=True)
        git("init", "-q", "-b", "main")
    install_hooks()
    created = []
    for path, text in ((CONFIG, DEFAULT_CONFIG), (VAULT / "COMMANDMENTS.md", COMMANDMENTS)):
        if not path.exists():
            path.write_text(text)
            created.append(path.name)
    if created:
        commit(build_message("init", ["memorytree"], "create vault",
                             "Default config and the commandments every agent follows.",
                             Agent=args.agent), created)
    print(f"memorytree vault ready at {VAULT}" + (f" (created {', '.join(created)})" if created else ""))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="memorytree", description="Git for AI memory.")
    parser.add_argument("--version", action="version", version=f"memorytree {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("config", help="print settings (all, or one key)")
    p.add_argument("key", nargs="?")
    p.set_defaults(func=cmd_config)

    p = sub.add_parser("init", help="create the vault, or clone an existing one")
    p.add_argument("--clone", metavar="URL", help="clone this vault repository instead of creating one")
    p.add_argument("--agent", help="the agent running init (recorded as provenance)")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("commit", help="commit vault changes as a memory event")
    p.add_argument("-k", "--kind", required=True, choices=KINDS)
    p.add_argument("-t", "--topic", required=True, action="append", help="repeatable; the first goes in the subject")
    p.add_argument("-m", "--message", required=True, help="one-line summary")
    p.add_argument("-b", "--body", help="why it changed and what was ruled out")
    for name in ("supersedes", "relates", "issue", "agent", "session"):
        p.add_argument(f"--{name}")
    p.add_argument("paths", nargs="*", help="what to commit (default: every change in the vault)")
    p.set_defaults(func=cmd_commit)

    p = sub.add_parser("search", help="search memories, one depth level at a time")
    p.add_argument("terms", nargs="+", help="english search terms")
    p.add_argument("-d", "--depth", type=int, default=2, choices=range(1, 6),
                   help="deepest level to search: 1 current, 2 history (default), 3 explorations, 4 archive, 5 notes")
    p.set_defaults(func=cmd_search)

    p = sub.add_parser("hook", help="(internal) git hooks installed in the vault by init")
    p.add_argument("name", choices=("pre-commit", "commit-msg"))
    p.add_argument("file", nargs="?", help="commit message file (commit-msg)")
    p.set_defaults(func=cmd_hook)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""memorytree: git for AI memory. See DESIGN.md."""
import argparse
import contextlib
import fcntl
import json
import os
import re
import socket
import sqlite3
import subprocess
import sys
import time
import tomllib
from pathlib import Path

VERSION = "0.1.24"
VAULT = Path(os.environ.get("MEMORYTREE_DIR", "~/.memorytree")).expanduser()
CONFIG = VAULT / "config"
CLAUDE_HOME = Path(os.environ.get("CLAUDE_CONFIG_DIR", "~/.claude")).expanduser()
CODEX_HOME = Path(os.environ.get("CODEX_HOME", "~/.codex")).expanduser()

DEFAULT_CONFIG = """\
# memorytree settings. Read with: git config -f ~/.memorytree/config <key>
# Per-machine overrides: git -C ~/.memorytree config memorytree.<key> <value>

[core]
    version = 1
    mode = economy           # economy | full: how compact memories, pinned rules and commandments are kept
    maxInstructionChars = 4000  # a CLAUDE.md/AGENTS.md edit may not grow it past this
[recall]
    maxMemories = 3          # memories injected per prompt
    maxChars = 1500          # characters per injected memory
    minScore = 2.0           # BM25 cutoff, applied once the vault has 30+ memories
    prefetch = true          # meaning-based recall through the capture call
    blockingExpand = false   # also expand each prompt synchronously (~4 s per prompt)
[capture]
    enabled = true
    maxPromptChars = 6000
    maxAnswerChars = 12000
    skipShortAnswer = 300    # skip turns whose prompt has no searchable word ("oi", "ok") and whose answer is shorter
[sync]
    pull = session-start     # session-start | never
    push = after-capture     # after-capture | manual
[agent "claude-code"]
    captureModel = haiku
    expandModel = haiku
[agent "codex"]
    captureModel = gpt-6-luna
    expandModel = gpt-6-luna
    reasoningEffort = low
"""


def git(*args, cwd=VAULT, check=True, input=None):
    return subprocess.run(["git", *args], cwd=cwd, check=check, capture_output=True, text=True, input=input)


def canonical(key):
    """git lowercases section and variable names, never the subsection."""
    parts = key.split(".")
    return ".".join([parts[0].lower(), *parts[1:-1], parts[-1].lower()])


def read_config(text):
    out = git("config", "-f", "-", "--list", cwd=None, input=text).stdout
    return dict(line.split("=", 1) for line in out.splitlines() if "=" in line)


DEFAULTS = read_config(DEFAULT_CONFIG)


def config():
    """Defaults, then the vault's config file, then per-machine overrides in .git/config."""
    values = dict(DEFAULTS)
    if CONFIG.is_file():
        values.update(read_config(CONFIG.read_text()))
    if (VAULT / ".git").is_dir():
        out = git("config", "--get-regexp", r"^memorytree\.", check=False).stdout
        for line in out.splitlines():
            key, _, value = line.partition(" ")
            values[key.removeprefix("memorytree.")] = value
    return values


def cmd_config(args):
    values = config()
    if args.key is None:
        print("\n".join(f"{k}={v}" for k, v in sorted(values.items())))
        return 0
    key = canonical(args.key)
    if key not in values:
        print(f"memorytree: unknown key {args.key}", file=sys.stderr)
        return 1
    print(values[key])
    return 0


COMMANDMENTS = """\
# memorytree
Your only memory is the git vault ~/.memorytree; never use or write built-in memory. Relevant memories arrive with each prompt and capture is automatic.
- An unknown name, project, decision or preference: `memorytree search <english terms> [-d 1-5]` before asking or exploring. Always English.
- History says why: before proposing an idea, check it wasn't already tried and dropped.
- "Where did we stop?": `git -C ~/.memorytree log -10 --format='%cs %s'`, then the project's plan (its ROADMAP.md, tracker or README) and recent git log. Never read a whole codebase to find out.
- Pinned rules change only on the user's explicit request. Never store secret values.
- Everything loaded into context is compiled for tokens (core.mode, economy by default): memories, pinned rules, CLAUDE.md, AGENTS.md. Dense facts, no filler or repetition, link depth instead of inlining it; every pinned memory carries a one-line `rule:`. Project docs (README, DESIGN, ROADMAP) are for people, read on demand: human-friendly, the why in full.
"""

KINDS = ("fact", "decision", "preference", "correction", "idea", "abandon", "migrate", "pin", "unpin",
         "issue", "progress", "close", "milestone", "sprint", "release", "init")
TRAILERS = ("Kind", "Topic", "Supersedes", "Relates", "Issue", "Agent", "Machine", "Session")
SUBJECT = re.compile(r"([a-z]+)\(([a-z0-9][a-z0-9./-]*)\): \S.*")
GIT_GENERATED = ("Merge ", "Revert ", "fixup! ", "squash! ")


def build_message(kind, topics, summary, body="", **trailers):
    lines = [f"{kind}({topics[0]}): {summary}", ""]
    if body:
        lines += [body.strip(), ""]
    values = {"Kind": kind, "Topic": ", ".join(topics), "Machine": socket.gethostname(), **trailers}
    lines += [f"{k}: {values[k]}" for k in TRAILERS if values.get(k)]
    return "\n".join(lines) + "\n"


def validate_message(message):
    """Errors for a memorytree commit message; empty when it is valid."""
    message = "\n".join(l for l in message.splitlines() if not l.startswith("#")).strip()
    subject = message.split("\n", 1)[0]
    if subject.startswith(GIT_GENERATED):
        return []
    m = SUBJECT.fullmatch(subject)
    if not m:
        return [f"subject must be 'kind(topic): summary', got: {subject!r}"]
    errors = []
    kind, topic = m.groups()
    if kind not in KINDS:
        errors.append(f"unknown kind {kind!r}; expected one of: {', '.join(KINDS)}")
    if len(subject) > 72:
        errors.append(f"subject is {len(subject)} characters; keep it under 73")
    if "\n" in message and message.split("\n")[1].strip():
        errors.append("the subject must be followed by a blank line")
    parsed = git("interpret-trailers", "--parse", cwd=None, input=message + "\n").stdout
    trailers = {}
    for line in parsed.splitlines():
        k, _, v = line.partition(":")
        trailers.setdefault(k.strip(), v.strip())
    if trailers.get("Kind") != kind:
        errors.append(f"trailer 'Kind: {kind}' is required and must match the subject")
    if topic not in [t.strip() for t in trailers.get("Topic", "").split(",")]:
        errors.append(f"trailer 'Topic:' is required and must include {topic!r}")
    return errors


def commit(message, paths=()):
    errors = validate_message(message)
    if errors:
        raise SystemExit("memorytree: " + "\n  ".join(["invalid commit message:", *errors]))
    git("add", "-A", "--", *(paths or ["."]))
    if git("diff", "--cached", "--quiet", check=False).returncode == 0:
        raise SystemExit("memorytree: nothing to commit")
    result = git("commit", "-q", "-F", "-", input=message, check=False)
    if result.returncode != 0:
        raise SystemExit("memorytree: commit refused\n" + result.stderr.strip())
    return git("rev-parse", "--short", "HEAD").stdout.strip()


def cmd_commit(args):
    trailers = {k.capitalize(): getattr(args, k) for k in ("supersedes", "relates", "issue", "agent", "session")}
    print(commit(build_message(args.kind, args.topic, args.message, args.body or "", **trailers), args.paths))
    return 0


MEMORY_DIRS = {"user", "pinned", "projects", "env", "topics"}
LAYOUT = MEMORY_DIRS | {"config", "COMMANDMENTS.md"}
SECRET = re.compile(
    r"sk-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|github_pat_\w{20,}|AKIA[0-9A-Z]{16}"
    r"|xox[abprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----")
# Plugin updates delete the old version's folder, so fall back to the newest installed copy.
HOOK = """#!/bin/sh
for script in '{script}' $(ls -d '{claude}'/plugins/cache/*/memorytree/*/bin/memorytree \\
        '{codex}'/plugins/cache/*/memorytree/*/bin/memorytree 2>/dev/null | sort -rV); do
    [ -f "$script" ] && MEMORYTREE_DIR="$(git rev-parse --show-toplevel)" exec python3 "$script" hook {name} "$@"
done
echo "memorytree: no installed memorytree script found; reinstall the plugin" >&2
exit 1
"""


def staged(diff_filter="ACMRD"):
    out = git("diff", "--cached", "--name-only", "-z", f"--diff-filter={diff_filter}").stdout
    return [p for p in out.split("\0") if p]


def check_staged():
    errors = []
    for path in staged("ACMR"):
        top = path.split("/")[0]
        if top not in LAYOUT:
            errors.append(f"{path}: outside the vault layout ({', '.join(sorted(LAYOUT))})")
            continue
        if "/" in path and not path.endswith(".md"):
            errors.append(f"{path}: memories are markdown files")
            continue
        text = git("show", f":{path}").stdout
        if SECRET.search(text):
            errors.append(f"{path}: contains what looks like a secret value; record where it lives instead")
        if path.startswith("pinned/") and config()["core.mode"] == "economy" and \
                not re.match(r"---\n(.*\n)*?rule: *\S.*\n(.*\n)*?---\n", text):
            errors.append(f"{path}: economy mode needs a one-line 'rule:' in the front matter of every pinned memory")
        if path.startswith("pinned/") and re.match(r"---\n(.*\n)*?level: *2\n(.*\n)*?---\n", text) and \
                not re.match(r"---\n(.*\n)*?keys: *\S.*\n(.*\n)*?---\n", text):
            errors.append(f"{path}: a level-2 pin loads only its keys, so it needs 'keys:' in the front matter")
        if "/" in path and not re.match(r"---\n(.*\n)*?title: *\S.*\n(.*\n)*?---\n", text):
            errors.append(f"{path}: needs front matter with a title")
    return errors


def check_message(message):
    errors = validate_message(message)
    subject = message.lstrip().split("\n", 1)[0]
    if not errors and not subject.startswith(GIT_GENERATED):
        kind = SUBJECT.fullmatch(subject).group(1)
        if kind not in ("pin", "unpin") and any(p.startswith("pinned/") for p in staged()):
            errors.append("pinned memories change only through a pin or unpin commit, on the user's explicit request")
    return errors


def cmd_hook(args):
    errors = check_staged() if args.name == "pre-commit" else check_message(Path(args.file).read_text())
    if errors:
        print("memorytree: commit refused\n  " + "\n  ".join(errors), file=sys.stderr)
        return 1
    return 0


def install_hooks():
    hooks = Path(git("rev-parse", "--git-path", "hooks").stdout.strip())
    hooks = hooks if hooks.is_absolute() else VAULT / hooks
    hooks.mkdir(parents=True, exist_ok=True)
    for name in ("pre-commit", "commit-msg"):
        (hooks / name).write_text(HOOK.format(script=Path(__file__).resolve(), name=name,
                                               claude=CLAUDE_HOME, codex=CODEX_HOME))
        (hooks / name).chmod(0o755)


STOPWORDS = set("""
the and for are but not you your with this that from have has was were will would could should can
what when where which who how why its into about then than them they there their our out all any just
also some more most very too only been being does did doing done let get got make made use using want
need like here now yes okay que para com não nao uma uns umas dos das por pra pro mas como mais isso
esse essa este esta aqui ele ela eles elas voce você meu minha seu sua tem ter foi ser são sao está
estou tipo assim então entao porque quando também tmb sim blz beleza valeu obrigado obrigada thanks thank pode
hey hello sure cool great nice please thx alright perfect awesome
""".split())


def is_memory(path):
    return "/" in path and path.endswith(".md") and path.split("/")[0] in MEMORY_DIRS


def terms(text):
    found = []
    for word in re.findall(r"\w+", text.lower()):
        if len(word) >= 3 and word not in STOPWORDS and not word.isdigit() and word not in found:
            found.append(word)
    return found[:40]


def front_matter(text):
    meta, body = {}, text
    if text.startswith("---\n"):
        head, sep, rest = text[4:].partition("\n---\n")
        if sep:
            body = rest
            for line in head.splitlines():
                k, _, v = line.partition(":")
                meta[k.strip()] = v.strip()
    return meta, body.strip()


def index():
    """FTS5 index of main's memories and commit messages, kept in .git so it never syncs.

    Updated incrementally from the last indexed commit; rebuilt when history was rewritten.
    """
    path = Path(git("rev-parse", "--absolute-git-dir").stdout.strip()) / "memorytree" / "index.db"
    path.parent.mkdir(exist_ok=True)
    db = sqlite3.connect(path, timeout=10)
    tokenize = "tokenize='unicode61 remove_diacritics 2'"
    db.execute(f"create virtual table if not exists files using fts5(path, title, keywords, body, {tokenize})")
    db.execute(f"create virtual table if not exists commits using fts5("
               f"sha unindexed, date unindexed, subject, topics, body, {tokenize})")
    db.execute("create table if not exists meta(key text primary key, value text)")
    head = git("rev-parse", "-q", "--verify", "HEAD", check=False).stdout.strip()
    row = db.execute("select value from meta where key = 'indexed'").fetchone()
    indexed = row[0] if row else ""
    if head == indexed:
        return db
    if indexed and git("merge-base", "--is-ancestor", indexed, head, check=False).returncode == 0:
        changed = git("diff", "--no-renames", "--name-only", "-z", indexed, head).stdout.split("\0")
        log_range = f"{indexed}..{head}"
    else:
        db.execute("delete from files")
        db.execute("delete from commits")
        changed = git("ls-tree", "-r", "-z", "--name-only", head).stdout.split("\0") if head else []
        log_range = head
    for p in filter(None, changed):
        db.execute("delete from files where path = ?", (p,))
        if not is_memory(p):
            continue
        shown = git("show", f"{head}:{p}", check=False)
        if shown.returncode == 0:
            meta, body = front_matter(shown.stdout)
            db.execute("insert into files values (?, ?, ?, ?)",
                       (p, meta.get("title", p), meta.get("keywords", ""), body))
    if log_range:
        out = git("log", "--format=%H%x1f%cs%x1f%B%x1e", log_range).stdout
        for record in filter(str.strip, out.split("\x1e")):
            sha, date, message = record.strip().split("\x1f", 2)
            topics = ", ".join(re.findall(r"^Topic: *(.+)$", message, re.M))
            subject, _, body = message.partition("\n")
            db.execute("insert into commits values (?, ?, ?, ?, ?)", (sha, date, subject, topics, body))
    db.execute("insert or replace into meta values ('indexed', ?)", (head,))
    db.commit()
    return db


def fts_query(words):
    return " OR ".join(f'"{w}"' for w in words)


def search_current(words, limit=10):
    if not words:
        return []
    return index().execute(
        "select path, title, -bm25(files, 5.0, 10.0, 5.0, 1.0) as score from files "
        "where files match ? order by score desc limit ?", (fts_query(words), limit)).fetchall()


def search_history(words, limit=10):
    if not words:
        return []
    return index().execute(
        "select sha, date, subject, -bm25(commits, 0, 0, 10.0, 5.0, 1.0) as score from commits "
        "where commits match ? order by score desc limit ?", (fts_query(words), limit)).fetchall()


def grep_refs(patterns, words):
    """Levels 3-5 are small and rarely searched: plain git grep over their trees, no index."""
    hits = []
    refs = git("for-each-ref", "--format=%(refname)%1f%(contents:subject)", *patterns).stdout.split("\n")
    for line in filter(None, refs):
        ref, _, message = line.partition("\x1f")
        matched = [w for w in words if w in message.lower()]
        grep = git("grep", "-I", "-i", "-c", "-F", *sum((["-e", w] for w in words), []), ref, check=False)
        for g in grep.stdout.splitlines():
            name, _, count = g.rpartition(":")
            hits.append((name, int(count)))
        if matched:
            hits.append((f"{ref} (message)", len(matched)))
    return sorted(hits, key=lambda h: -h[1])


LEVELS = (
    (1, "current state"),
    (2, "history"),
    (3, "explorations (refs/heads/explore/*)"),
    (4, "archive (refs/tags/archived/*, refs/tags/moment/*)"),
    (5, "hindsight notes (refs/notes/hindsight)"),
)


def cmd_search(args):
    words = terms(" ".join(args.terms))
    if not words:
        print("memorytree: no searchable terms", file=sys.stderr)
        return 1
    found = False
    for level, name in LEVELS[:args.depth]:
        if level == 1:
            rows = [f"{path}  {title}  [{score:.1f}]" for path, title, score in search_current(words)]
        elif level == 2:
            rows = [f"{sha[:7]} {date}  {subject}  [{score:.1f}]" for sha, date, subject, score in search_history(words)]
        else:
            patterns = {3: ["refs/heads/explore/"], 4: ["refs/tags/archived/", "refs/tags/moment/"],
                        5: ["refs/notes/hindsight"]}[level]
            rows = [f"{hit}  [{count}]" for hit, count in grep_refs(patterns, words)]
        if rows:
            found = True
            print(f"== level {level}: {name}")
            print("\n".join(rows))
    return 0 if found else 1


GLOBAL_INSTRUCTIONS = {"claude-code": CLAUDE_HOME / "CLAUDE.md", "codex": CODEX_HOME / "AGENTS.md"}
BLOCK = re.compile(r"<!-- memorytree -->\n.*?<!-- /memorytree -->\n?", re.S)


def pinned_memories(node=""):
    """Pins directly under pinned/<node>: root pins load every session, deeper ones through `show`."""
    return [(str(p.relative_to(VAULT)), *front_matter(p.read_text()))
            for p in sorted((VAULT / "pinned" / node).glob("*.md"))]


def pin_line(rel, meta, body, full=False):
    """(is_key, line). A level-2 pin is only its keys and its node; a pin with pins under it names its node."""
    node = rel.removeprefix("pinned/").removesuffix(".md")
    if not full and meta.get("level") == "2" and meta.get("keys"):
        return True, f"- [{'|'.join(k.strip() for k in meta['keys'].split(','))}] → {node}"
    more = f" → {node}" if (VAULT / "pinned" / node).is_dir() else ""
    return False, f"- {' '.join(body.split()) if full else meta.get('rule') or ' '.join(body.split())}{more}"


def commandments_block():
    """Commandments plus pinned memories. They go into the agents' global instructions, which subagents
    read too; hook injections only reach the main session."""
    text = (VAULT / "COMMANDMENTS.md").read_text() if (VAULT / "COMMANDMENTS.md").is_file() else COMMANDMENTS
    text = text.strip()
    # This block loads even when the hooks don't run, so it is what can tell the user they aren't running.
    text += ("\nHook check: if your context lacks \"memorytree is active\", tell the user first that its hooks aren't "
             "running (Codex: trust them in /hooks; Claude Code: enable the plugin), then to start a new session.")
    # Each pin's one-line `rule` is what loads every session; its full text stays in the vault, a search away.
    # A level-2 pin loads only its keys, like a skill's description: the agent opens the file when the task
    # touches one. The model decides, not a keyword hook, so a missed trigger can't silently drop the rule.
    # Only root pins load; the tree below them is walked with `show`, one node at a time.
    full = config()["core.mode"] == "full"
    lines = [pin_line(rel, meta, body, full) for rel, meta, body in pinned_memories()]
    pins, keyed = [line for key, line in lines if not key], [line for key, line in lines if key]
    if pins:
        text += "\n\n# Pinned rules\n" + "\n".join(pins)
    if keyed:
        text += "\n\n# Pinned keys\n" + "\n".join(keyed)
    if keyed or any((VAULT / rel.removesuffix(".md")).is_dir() for rel, _, _ in pinned_memories()):
        text += ("\n`→ node`: when a task touches a key or rule, run `memorytree show <node>` before acting and "
                 "follow it as a pinned rule; it lists the keys one level deeper.")
    text = text.replace("`memorytree ", f"`python3 {Path(__file__).resolve()} ")
    return f"<!-- memorytree -->\n{text}\n<!-- /memorytree -->\n"


def install_commandments(agent, remove=False):
    """Write (or refresh, or remove) the commandments block in the agent's global instructions."""
    path = GLOBAL_INSTRUCTIONS[agent]
    old = path.read_text() if path.is_file() else ""
    rest = BLOCK.sub("", old)
    new = rest if remove else (rest.rstrip() + "\n\n" if rest.strip() else "") + commandments_block()
    if new != old:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(new)
    return new != old


def cmd_show(args):
    """One step down the pin tree: a pin in full, then the keys of the pins under it."""
    node = args.node.strip("/").removeprefix("pinned/").removesuffix(".md")
    path = VAULT / "pinned" / f"{node}.md"
    if not path.is_file():
        print(f"memorytree: no pinned node {node!r}", file=sys.stderr)
        return 1
    meta, body = front_matter(path.read_text())
    print(f"# {meta.get('title', node)}\n{body}")
    deeper = [pin_line(rel, meta, body)[1] for rel, meta, body in pinned_memories(node)]
    if deeper:
        print("\n# Deeper (memorytree show <node>)\n" + "\n".join(deeper))
    return 0


def cmd_install(args):
    for agent in args.agents or GLOBAL_INSTRUCTIONS:
        changed = install_commandments(agent, remove=args.uninstall)
        print(f"{GLOBAL_INSTRUCTIONS[agent]}: {'updated' if changed else 'unchanged'}")
    return 0


def native_memory_on(agent):
    """Why the agent's built-in memory is on, or None. memorytree refuses to run alongside it."""
    if agent == "claude-code":
        if os.environ.get("CLAUDE_CODE_DISABLE_AUTO_MEMORY") == "1":
            return None
        try:
            settings = json.loads((CLAUDE_HOME / "settings.json").read_text())
        except (OSError, ValueError):
            settings = {}
        if settings.get("autoMemoryEnabled", True) is not False:
            return f'Claude Code auto memory is on (set "autoMemoryEnabled": false in {CLAUDE_HOME / "settings.json"})'
    if agent == "codex":
        try:
            settings = tomllib.loads((CODEX_HOME / "config.toml").read_text())
        except (OSError, ValueError):
            settings = {}
        if settings.get("features", {}).get("memories") is True:
            return f"Codex memories are on (set memories = false under [features] in {CODEX_HOME / 'config.toml'})"
    return None


def context(event, text, status=None):
    """additionalContext goes to the model; systemMessage is shown to the user in both agents' UI."""
    out = {"hookSpecificOutput": {"hookEventName": event, "additionalContext": text}}
    if status:
        out["systemMessage"] = status
    return json.dumps(out)


def session_path(session_id):
    safe = re.sub(r"[^A-Za-z0-9_-]", "", str(session_id))[:100] or "unknown"
    return Path(git("rev-parse", "--absolute-git-dir").stdout.strip()) / "memorytree" / "sessions" / f"{safe}.json"


def load_session(session_id):
    try:
        return json.loads(session_path(session_id).read_text())
    except (OSError, ValueError):
        return {"seen": [], "prompt": ""}


def save_session(session_id, state):
    path = session_path(session_id)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(state))


def detach(*command):
    work = session_path("x").parent.parent
    work.mkdir(parents=True, exist_ok=True)
    log = open(work / "capture.log", "a")
    subprocess.Popen(command, cwd=VAULT, stdin=subprocess.DEVNULL, stdout=log, stderr=log, start_new_session=True)


def on_session_start(event, agent):
    if not (VAULT / ".git").is_dir():
        return context("SessionStart", f"memorytree is installed but has no vault at {VAULT}. "
                       "Tell the user once and offer to run the memorytree setup.",
                       f"memorytree: no vault at {VAULT} - run the memorytree setup")
    reason = native_memory_on(agent)
    if reason:
        return context("SessionStart", f"memorytree is NOT active: {reason}. memorytree refuses to run alongside "
                       "built-in memory. Tell the user and offer to turn it off; nothing is recalled or captured "
                       "until then.", f"memorytree NOT active: {reason}")
    if event.get("source") in ("clear", "compact"):
        save_session(event.get("session_id"), {"seen": [], "prompt": ""})
    if config()["sync.pull"] == "session-start" and git("remote", check=False).stdout.strip():
        detach(sys.executable, str(Path(__file__).resolve()), "sync", agent)
    # Plugin updates move this script, so re-point the vault's git hooks and the commandments block at it.
    install_hooks()
    installed = bool(BLOCK.search(GLOBAL_INSTRUCTIONS[agent].read_text() if GLOBAL_INSTRUCTIONS[agent].is_file() else ""))
    if installed:
        install_commandments(agent)
    parts = [f"memorytree is active. Search: `python3 {Path(__file__).resolve()} search <english terms>`."]
    if (VAULT / "user/profile.md").is_file():
        meta, body = front_matter((VAULT / "user/profile.md").read_text())
        parts.append(f"## {meta.get('title', 'User profile')} (user/profile.md)\n{body}")
    if not installed:  # otherwise the pinned memories already arrive through the global instructions
        parts += [f"## {meta.get('title', rel)} ({rel})\n{body}" for rel, meta, body in pinned_memories()]
    memories = sum(1 for p in VAULT.rglob("*.md") if is_memory(str(p.relative_to(VAULT))))
    status = f"memorytree active: {memories} memories, {len(pinned_memories())} pinned"
    return context("SessionStart", "\n\n".join(parts), status)


def recall(prompt, session_id):
    """Memories for this prompt: prefetched by the last capture, then FTS hits; each at most once per session."""
    cfg = config()
    limit, max_chars = int(cfg["recall.maxmemories"]), int(cfg["recall.maxchars"])
    state = load_session(session_id)
    state["prompt"] = prompt
    db = index()
    candidates = [db.execute("select path, title, body from files where path = ?", (p,)).fetchone()
                  for p in state.pop("prefetched", [])]
    words = terms(prompt)
    if words:
        # BM25's IDF is ~0 in a tiny corpus, so the cutoff only means something once the vault has grown.
        min_score = float(cfg["recall.minscore"]) if db.execute("select count(*) from files").fetchone()[0] >= 30 else 0
        rows = db.execute(
            "select path, title, body, -bm25(files, 5.0, 10.0, 5.0, 1.0) as score from files "
            "where files match ? order by score desc limit ?", (fts_query(words), limit + len(state["seen"]) + 10))
        candidates += [row[:3] for row in rows if row[3] >= min_score]
    hits = []
    for row in filter(None, candidates):
        path, title, body = row
        if path not in state["seen"] and path != "user/profile.md" and not path.startswith("pinned/"):  # loaded at start
            state["seen"].append(path)
            hits.append((path, title, body if len(body) <= max_chars else body[:max_chars] + " [...]"))
        if len(hits) == limit:
            break
    save_session(session_id, state)
    return hits


def on_prompt(event, agent):
    if not (VAULT / ".git").is_dir() or native_memory_on(agent):
        return ""
    hits = recall(event.get("prompt") or "", event.get("session_id"))
    if not hits:
        return ""
    text = "Memories recalled by memorytree for this prompt:\n\n" + "\n\n".join(
        f"## {title} ({path})\n{body}" for path, title, body in hits)
    return context("UserPromptSubmit", text)


NATIVE_MEMORY_PATHS = (re.compile(re.escape(str(CLAUDE_HOME / "projects")) + r"/[^/]+/memory/"),
                       re.compile(re.escape(str(CODEX_HOME / "memories")) + "/"))


def deny(reason):
    return json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": reason}})


def on_tool(event, agent):
    """Deny writes to built-in memory locations, and instruction files grown past the token budget."""
    tool = event.get("tool_input") or {}
    path = str(tool.get("file_path", ""))
    if path and any(p.match(str(Path(path).expanduser())) for p in NATIVE_MEMORY_PATHS):
        return deny("memorytree is the only memory: built-in memory files are off limits. "
                    "Record this in memorytree instead.")
    if Path(path).name in ("CLAUDE.md", "AGENTS.md"):
        file = Path(path).expanduser()
        old = file.read_text() if file.is_file() else ""
        new = tool["content"] if "content" in tool else \
            old.replace(tool.get("old_string", ""), tool.get("new_string", ""), -1 if tool.get("replace_all") else 1)
        limit = int(config()["core.maxinstructionchars"])
        # Shrinking is always allowed, so a file already over the limit can be compiled step by step.
        if len(new) > limit and len(new) >= len(old):
            return deny(f"{file.name} would be {len(new)} chars, over core.maxInstructionChars ({limit}). "
                        "It loads every session, so it is written for the model: one dense line per rule. "
                        "Move detail and the why to README/DESIGN/docs (read on demand, written for people) "
                        "and link them.")
    return ""


def last_assistant_text(transcript_path):
    """Claude Code transcripts are JSONL; collect the assistant text blocks of the last turn."""
    try:
        lines = Path(transcript_path).read_text().splitlines()
    except (OSError, TypeError):
        return ""
    texts = []
    for line in reversed(lines):
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        content = entry.get("message", {}).get("content")
        if entry.get("type") == "user" and isinstance(content, str):
            break  # the prompt that started this turn
        if entry.get("type") == "assistant" and isinstance(content, list):
            texts += [b.get("text", "") for b in reversed(content) if isinstance(b, dict) and b.get("type") == "text"]
    return "\n\n".join(reversed(texts)).strip()


def on_stop(event, agent):
    """Hand the turn to a detached capture process, so closing the session right away loses nothing."""
    if not (VAULT / ".git").is_dir() or native_memory_on(agent) or config()["capture.enabled"] != "true":
        return "{}"
    state = load_session(event.get("session_id"))
    answer = event.get("last_assistant_message") or last_assistant_text(event.get("transcript_path"))
    trivial = not terms(state.get("prompt", "")) and len(answer) < int(config()["capture.skipshortanswer"])
    if not trivial:  # an "oi" or "ok" with a short reply holds nothing to remember; skip the model call
        queue = session_path("x").parent.parent / "queue"
        queue.mkdir(parents=True, exist_ok=True)
        job = queue / f"{time.time_ns()}.json"
        job.write_text(json.dumps({"agent": agent, "session_id": event.get("session_id"), "cwd": event.get("cwd", ""),
                                   "prompt": state.get("prompt", ""), "answer": answer}))
        detach(sys.executable, str(Path(__file__).resolve()), "capture", str(job))
    return "{}"  # Codex requires JSON from Stop hooks


AGENT_EVENTS = {"session-start": on_session_start, "prompt": on_prompt, "tool": on_tool, "stop": on_stop}


CAPTURE_PROMPT = """You maintain memorytree, a git repository of memories shared by one user's coding agents \
(Claude Code, Codex) across machines. Below is the latest exchange between the user and an agent working in {cwd}, \
then existing memories that may be related.

Decide what from this exchange is worth remembering in future sessions:
- the user: preferences, how they like to work, corrections and why, what they explicitly endorsed;
- projects: purpose, status, decisions and their reasons, what was ruled out, constraints, where things live;
- environment: machines, paths, accounts, services, external resources.
Skip what is transient, obvious from code or git history, or already recorded. Most exchanges contain nothing new.

Rules:
- English only, factual, even when the user writes in another language. Today is {today}.
- {style}
- Paths: user/profile.md (stable facts about the user, under 40 lines), projects/<name>/<file>.md, env/<file>.md, \
topics/<file>.md. Lowercase, hyphens, .md. One memory per subject: to change one, return its full new content under \
the same path. Link related memories with [[path-without-.md]].
- pinned/<slug>.md only when the user explicitly asked in this exchange to pin, update or remove a pinned memory; \
then the commit kind is pin or unpin. Praise without an explicit request is a preference, never a pin.
- Never record secret values; record where they live.
- The commit body says why, and what was ruled out. That is how the path from one idea to the next is remembered.

Return ONLY JSON:
{{"memories": [{{"path": "...", "title": "...", "keywords": "english search terms", "body": "markdown", \
"rule": "pinned only"}}, \
{{"path": "...", "delete": true}}],
 "commit": {{"kind": "one of {kinds}", "topics": ["main-topic"], "summary": "imperative, under 60 characters", \
"body": "why"}},
 "next_terms": "english keywords for what this conversation is about now"}}
With nothing worth remembering, return {{"memories": [], "next_terms": "..."}}.

<user_prompt>
{prompt}
</user_prompt>

<agent_answer>
{answer}
</agent_answer>

<existing_memories>
{memories}
</existing_memories>
"""

MERGE_PROMPT = """Two machines changed the same memorytree memory file at the same time. Merge them into one memory \
that keeps every fact that is still true; where they contradict, prefer version B (the newer one). Keep the front \
matter format. Return ONLY the merged file content.

<version_a>
{a}
</version_a>

<version_b>
{b}
</version_b>
"""
STYLE = {
    "economy": "Compile every memory for tokens: dense bullet facts, no filler, no repetition, no restating the title; "
               "keep each file under 1,000 characters. A pinned memory also needs \"rule\": its one-line form.",
    "full": "Write each memory as clear prose with the context a reader needs.",
}
MEMORY_PATH = re.compile(r"(user|pinned|projects|env|topics)(/[a-z0-9][a-z0-9_.-]*)+\.md")


def run_model(agent, prompt):
    """The cheap model from config, run non-interactively with every hook off so it can't recurse."""
    cfg = config()
    env = {**os.environ, "MEMORYTREE_NESTED": "1"}
    if f"agent.{agent}.command" in cfg:  # any other agent or model: a command that reads stdin, prints the answer
        return subprocess.run(cfg[f"agent.{agent}.command"], shell=True, input=prompt, env=env,
                              capture_output=True, text=True, timeout=300, cwd=VAULT).stdout
    model = cfg[f"agent.{agent}.capturemodel"]
    if agent == "codex":
        out = session_path("x").parent.parent / f"codex-{os.getpid()}.txt"
        subprocess.run(["codex", "exec", "--ephemeral", "--skip-git-repo-check", "-m", model, "-c",
                        f"model_reasoning_effort={cfg.get('agent.codex.reasoningeffort', 'low')}",
                        "--disable", "hooks", "-s", "read-only", "-o", str(out)],
                       input=prompt, env=env, capture_output=True, text=True, timeout=300, cwd=out.parent)
        text = out.read_text() if out.exists() else ""
        out.unlink(missing_ok=True)
        return text
    return subprocess.run(["claude", "-p", "--model", model, "--no-session-persistence", "--tools", "",
                           "--strict-mcp-config", "--settings", '{"disableAllHooks": true}'],
                          input=prompt, env=env, capture_output=True, text=True, timeout=300,
                          cwd=session_path("x").parent.parent).stdout


def parse_json(text):
    start, end = text.find("{"), text.rfind("}")
    try:
        return json.loads(text[start:end + 1]) if 0 <= start < end else {}
    except ValueError:
        return {}


def topic_slug(text):
    return re.sub(r"[^a-z0-9./-]+", "-", str(text).lower()).strip("-./") or "memory"


def apply_capture(result, agent, session_id):
    """Write the model's memories and commit them as one event. Returns the commit hash, or None."""
    written = []
    for item in result.get("memories") or []:
        path = str(item.get("path", "")) if isinstance(item, dict) else ""
        if not MEMORY_PATH.fullmatch(path):
            continue
        target = VAULT / path
        if item.get("delete"):
            if target.exists():
                target.unlink()
                written.append(path)
            continue
        body = str(item.get("body", "")).strip()
        if not body:
            continue
        one_line = lambda v: " ".join(str(v).split())
        target.parent.mkdir(parents=True, exist_ok=True)
        rule = f"rule: {one_line(item['rule'])}\n" if path.startswith("pinned/") and item.get("rule") else ""
        target.write_text(SECRET.sub("[REDACTED]", f"---\ntitle: {one_line(item.get('title') or target.stem)}\n"
                                                   f"keywords: {one_line(item.get('keywords', ''))}\n{rule}---\n\n{body}\n"))
        written.append(path)
    if not written:
        return None
    c = result.get("commit") or {}
    kind = c.get("kind") if c.get("kind") in KINDS else "fact"
    topics = [topic_slug(t)[:30] for t in (c.get("topics") or [written[0].split("/")[-1][:-3]])]
    room = 72 - len(f"{kind}({topics[0]}): ")  # the subject must fit git's one-line view
    summary = " ".join(str(c.get("summary") or f"update {', '.join(written)}").split())
    if len(summary) > room:
        summary = summary[:room + 1].rsplit(" ", 1)[0]
    message = build_message(kind, topics, summary, SECRET.sub("[REDACTED]", str(c.get("body") or "")),
                            Agent=agent, Session=session_id)
    try:
        return commit(message, written)
    except SystemExit as refused:  # the vault's hooks said no: log it, and put back exactly what was touched
        print(refused, file=sys.stderr)
        for path in written:
            if git("cat-file", "-e", f"HEAD:{path}", check=False).returncode == 0:
                git("checkout", "-q", "HEAD", "--", path)
            else:
                (VAULT / path).unlink(missing_ok=True)
        return None


def sync(agent):
    """Pull with rebase, resolving conflicting memories with the cheap model, then push."""
    if not git("remote", check=False).stdout.strip():
        return
    git("pull", "-q", "--rebase", check=False)
    for _ in range(20):  # one round per replayed commit; give up rather than loop forever
        conflicted = [p for p in git("diff", "--name-only", "--diff-filter=U", check=False).stdout.splitlines() if p]
        if not conflicted:
            break
        for path in conflicted:
            a = git("show", f":2:{path}", check=False).stdout
            b = git("show", f":3:{path}", check=False).stdout
            merged = run_model(agent, MERGE_PROMPT.format(a=a, b=b)).strip()
            if not merged.startswith("---\n"):
                merged = b or a
            (VAULT / path).write_text(SECRET.sub("[REDACTED]", merged) + "\n")
            git("add", "--", path)
        if git("-c", "core.editor=true", "rebase", "--continue", check=False).returncode and \
                not git("diff", "--name-only", "--diff-filter=U", check=False).stdout.strip():
            break
    if (VAULT / git("rev-parse", "--git-path", "rebase-merge").stdout.strip()).exists():
        git("rebase", "--abort", check=False)  # unresolved: keep local commits, retry on the next capture
        return
    git("push", "-q", check=False)


def cmd_capture(args):
    job = Path(args.job)
    try:
        capture(json.loads(job.read_text()))
    except BaseException:
        job.rename(job.with_suffix(".failed"))  # kept for inspection; the traceback goes to capture.log
        raise
    job.unlink(missing_ok=True)
    return 0


@contextlib.contextmanager
def vault_lock():
    """One lock per vault around every capture and sync: concurrent pulls race on FETCH_HEAD, and two
    captures must never rewrite the same memory blindly."""
    path = session_path("x").parent.parent / "vault.lock"
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def cmd_sync(args):
    with vault_lock():
        sync(args.agent)
    return 0


def capture(payload):
    agent, session_id, cfg = payload["agent"], payload.get("session_id"), config()
    log_path = session_path("x").parent.parent / "capture.log"
    with vault_lock():
        prompt = payload.get("prompt", "")[:int(cfg["capture.maxpromptchars"])]
        answer = payload.get("answer", "")[:int(cfg["capture.maxanswerchars"])]
        related = search_current(terms(prompt + " " + answer[:4000]), limit=5)
        memories = "\n\n".join(f"### {path}\n{(VAULT / path).read_text()}" for path, *_ in related
                               if (VAULT / path).is_file()) or "(none)"
        result = parse_json(run_model(agent, CAPTURE_PROMPT.format(
            cwd=payload.get("cwd", ""), today=time.strftime("%Y-%m-%d"), kinds=", ".join(KINDS),
            style=STYLE.get(cfg["core.mode"], STYLE["economy"]),
            prompt=prompt, answer=answer, memories=memories)))
        sha = apply_capture(result, agent, session_id)
        if sha and cfg["sync.push"] == "after-capture":
            sync(agent)
        if cfg["recall.prefetch"] == "true" and result.get("next_terms"):
            state = load_session(session_id)
            state["prefetched"] = [p for p, *_ in search_current(terms(str(result["next_terms"])), limit=10)
                                   if p not in state["seen"]][:int(cfg["recall.maxmemories"])]
            save_session(session_id, state)
        with open(log_path, "a") as f:
            f.write(f"{time.strftime('%F %T')} {agent} {session_id}: {sha or 'nothing new'}\n")


def cmd_agent_hook(args):
    if os.environ.get("MEMORYTREE_NESTED"):
        return 0  # the capture model's own session must not recall or capture
    try:
        out = AGENT_EVENTS[args.event](json.load(sys.stdin), args.agent)
    except Exception as e:  # a memory hook must never break the user's session
        print(f"memorytree: {e}", file=sys.stderr)
        out = ""
    if out:
        print(out)
    return 0


def cmd_init(args):
    if args.clone and not VAULT.exists():
        git("clone", "-q", args.clone, str(VAULT), cwd=None)
        if git("rev-parse", "-q", "--verify", "HEAD", check=False).returncode:  # empty remote
            git("symbolic-ref", "HEAD", "refs/heads/main")
    elif not (VAULT / ".git").is_dir():
        VAULT.mkdir(parents=True, exist_ok=True)
        git("init", "-q", "-b", "main")
    install_hooks()
    created = []
    for path, text in ((CONFIG, DEFAULT_CONFIG), (VAULT / "COMMANDMENTS.md", COMMANDMENTS)):
        if not path.exists():
            path.write_text(text)
            created.append(path.name)
    if created:
        commit(build_message("init", ["memorytree"], "create vault",
                             "Default config and the commandments every agent follows.",
                             Agent=args.agent), created)
    if created and git("remote", check=False).stdout.strip():
        git("push", "-q", "-u", "origin", "main", check=False)
    print(f"memorytree vault ready at {VAULT}" + (f" (created {', '.join(created)})" if created else ""))
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="memorytree", description="Git for AI memory.")
    parser.add_argument("--version", action="version", version=f"memorytree {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("config", help="print settings (all, or one key)")
    p.add_argument("key", nargs="?")
    p.set_defaults(func=cmd_config)

    p = sub.add_parser("init", help="create the vault, or clone an existing one")
    p.add_argument("--clone", metavar="URL", help="clone this vault repository instead of creating one")
    p.add_argument("--agent", help="the agent running init (recorded as provenance)")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("commit", help="commit vault changes as a memory event")
    p.add_argument("-k", "--kind", required=True, choices=KINDS)
    p.add_argument("-t", "--topic", required=True, action="append", help="repeatable; the first goes in the subject")
    p.add_argument("-m", "--message", required=True, help="one-line summary")
    p.add_argument("-b", "--body", help="why it changed and what was ruled out")
    for name in ("supersedes", "relates", "issue", "agent", "session"):
        p.add_argument(f"--{name}")
    p.add_argument("paths", nargs="*", help="what to commit (default: every change in the vault)")
    p.set_defaults(func=cmd_commit)

    p = sub.add_parser("search", help="search memories, one depth level at a time")
    p.add_argument("terms", nargs="+", help="english search terms")
    p.add_argument("-d", "--depth", type=int, default=2, choices=range(1, 6),
                   help="deepest level to search: 1 current, 2 history (default), 3 explorations, 4 archive, 5 notes")
    p.set_defaults(func=cmd_search)

    p = sub.add_parser("show", help="print a pinned node and the keys one level deeper")
    p.add_argument("node", help="e.g. scripts or scripts/posix-shell")
    p.set_defaults(func=cmd_show)

    p = sub.add_parser("install", help="write the commandments into each agent's global instructions")
    p.add_argument("agents", nargs="*", choices=list(GLOBAL_INSTRUCTIONS))
    p.add_argument("--uninstall", action="store_true", help="remove the commandments block instead")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("agent-hook", help="(internal) Claude Code and Codex hooks shipped by the plugin")
    p.add_argument("event", choices=AGENT_EVENTS)
    p.add_argument("agent", choices=GLOBAL_INSTRUCTIONS)
    p.set_defaults(func=cmd_agent_hook)

    p = sub.add_parser("sync", help="pull (resolving conflicts) and push the vault, under the vault lock")
    p.add_argument("agent", nargs="?", default="claude-code", choices=GLOBAL_INSTRUCTIONS,
                   help="whose cheap model resolves conflicts")
    p.set_defaults(func=cmd_sync)

    p = sub.add_parser("capture", help="(internal) capture one queued turn; run detached by the stop hook")
    p.add_argument("job")
    p.set_defaults(func=cmd_capture)

    p = sub.add_parser("hook", help="(internal) git hooks installed in the vault by init")
    p.add_argument("name", choices=("pre-commit", "commit-msg"))
    p.add_argument("file", nargs="?", help="commit message file (commit-msg)")
    p.set_defaults(func=cmd_hook)

    args = parser.parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
